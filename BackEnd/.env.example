# ===== BackEnd =====
# Copia este archivo como .env y ajusta los valores
NODE_ENV=development
PORT=4000

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# URLs de los otros servicios del proyecto
SECURITY_SERVICE_URL=http://localhost:8080/api/auth
PHOTOS_SERVICE_URL=http://localhost:8000/api/v1

# Secreto para firmar los tokens que reenviamos al frontend
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=3600

# ===== PostgreSQL =====
# Host y puerto del servidor. Si usas Docker en la misma red, pon el nombre
# del servicio (por ejemplo "db") en lugar de localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=photos_app
DB_USER=postgres
DB_PASSWORD=postgres

# true si el servidor exige SSL (Azure, RDS, Supabase...)
DB_SSL=false

# Niveles de log de TypeORM: error, warn, info, migration (separados por coma)
DB_LOGGING=error,warn,migration
