# ===== MicroServicios (Python / FastAPI) =====
# Copia este archivo como .env y ajusta los valores
APP_NAME=photos-service
APP_VERSION=0.1.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

# URLs de los otros servicios
BACKEND_URL=http://localhost:4000
SECURITY_SERVICE_URL=http://localhost:8080/api/auth

# Base de datos (aun no se usa, queda preparada)
DATABASE_URL=sqlite+aiosqlite:///./photos.db
