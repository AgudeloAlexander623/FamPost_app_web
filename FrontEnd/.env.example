# ===== FrontEnd =====
# Copia este archivo como .env y ajusta los valores
# URL del backend (tambien se usa en el proxy de Vite)
VITE_BACKEND_URL=http://localhost:4000

# URL base que usa axios para las llamadas a la API
VITE_API_URL=/api

# URL del microservicio de seguridad (Java)
VITE_SECURITY_SERVICE_URL=http://localhost:8080/api/auth
